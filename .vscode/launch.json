{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "jdk",
      "request": "launch",
      "name": "Launch Java App"
    },
    {
      "name": "Attach to Port",
      "type": "jdk",
      "request": "attach",
      "hostName": "localhost",
      "port": "8000"
    },
    {
      "name": "Attach to Process",
      "type": "jdk",
      "request": "attach",
      "processId": "${command:jdk.java.attachDebugger.pickProcess}"
    },
    {
      "name": "Listen on Port",
      "type": "jdk",
      "request": "attach",
      "hostName": "localhost",
      "port": "8000",
      "listen": "true"
    }
  ]
}
